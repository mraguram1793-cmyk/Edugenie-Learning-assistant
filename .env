# ─────────────────────────────────────────────────────────────────────────────
# EduGenie – Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini API ────────────────────────────────────────────────────────────────
# Your Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AQ.Ab8RN6Kd2ZoINk-36PE2gTz-VLh5VbX3aNieJuZM3CjgfDSn9g

# ── Gemini Cloud Model ────────────────────────────────────────────────────────
# The Gemini model used for Q&A, summarization, quiz generation, and learning paths.
# Confirmed working: gemini-3-flash-preview
GEMINI_MODEL=gemini-3-flash-preview

# ── Local Explanation Model ───────────────────────────────────────────────────
# HuggingFace model ID used for local (offline) topic explanations.
# Change this to swap the local model without touching source code.
# Default: MBZUAI/LaMini-Flan-T5-783M
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
